<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bobrrent.controllers.HomeController">
    <left>
        <VBox prefHeight="600.0" prefWidth="230.0" style="-fx-background-color: #2E5525; -fx-background-radius: 0 30 30 0;" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" prefHeight="150.0" prefWidth="230.0" spacing="10.0">
                    <children>
                        <ImageView fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/mylogobobr.png" />
                            </image>
                        </ImageView>
                    </children>
                </VBox>
                <VBox prefHeight="350.0" prefWidth="230.0" spacing="15.0">
                    <padding>
                        <Insets left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="190.0" style="-fx-background-color: #3E6B32; -fx-background-radius: 10;" text="  🏠  Dashboard" textFill="WHITE">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="55.0" prefWidth="200.0" style="-fx-background-color: transparent;" text="    Browse Cars" textFill="WHITE" />
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="55.0" prefWidth="200.0" style="-fx-background-color: transparent;" text="    My Bookings" textFill="WHITE" />
                        <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="55.0" prefWidth="200.0" style="-fx-background-color: transparent;" text="    Profile" textFill="WHITE" />
                    </children>
                </VBox>
                <VBox alignment="BOTTOM_CENTER" prefHeight="100.0" prefWidth="230.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #7A4E2D; -fx-background-radius: 20;" text="Logout" textFill="WHITE">
                            <VBox.margin>
                                <Insets bottom="30.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="20.0" style="-fx-background-color: #F4F7F6;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" style="-fx-background-color: #2E5525; -fx-background-radius: 20;">
                    <children>
                        <VBox alignment="CENTER_LEFT" spacing="5.0">
                            <children>
                                <Label text="Welcome to BóbrRent Management" textFill="WHITE">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <Label text="Track your fleet and manage rentals in real-time" textFill="#e0e0e0">
                                    <font><Font size="14.0" /></font>
                                </Label>
                            </children>
                            <HBox.margin><Insets left="30.0" /></HBox.margin>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <children>
                                <Label text="Total Fleet" textFill="#7a7a7a" />
                                <Label text="24 Cars" textFill="#2E5525">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <children>
                                <Label text="Available" textFill="#7a7a7a" />
                                <Label text="18" textFill="#3E6B32">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                    <children>
                        <Label text="Live Inventory Status" textFill="#2E5525">
