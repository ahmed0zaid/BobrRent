<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bobrrent.controllers.ProfileController">
    <children>
        <VBox alignment="CENTER" maxWidth="500.0" spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
            <padding>
                <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="👤" style="-fx-font-size: 60;" />
                        <Label fx:id="fullNameLabel" text="User Name">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                        <Label fx:id="phoneLabel" text="+48 000 000 000" textFill="#7a7a7a">
                            <font><Font size="16.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <Separator prefWidth="200.0" />

                <GridPane hgap="20.0" vgap="20.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Gender:" textFill="#2E5525">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Label fx:id="genderLabel" text="Not Set" GridPane.columnIndex="1">
                            <font><Font size="14.0" /></font>
                        </Label>

                        <Label text="Birthday:" textFill="#2E5525" GridPane.rowIndex="1">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                        <Label fx:id="birthdayLabel" text="YYYY-MM-DD" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </children>
                </GridPane>

                <Button onAction="#handleEditProfile" prefWidth="200.0" style="-fx-background-color: #2E5525; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 10;" text="Edit Profile" />
            </children>
        </VBox>
    </children>
</StackPane>